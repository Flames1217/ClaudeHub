{
  "name": "claudehub",
  "version": "0.3.4",
  "description": "Claude 多账号聚合桌面端与浏览器扩展。",
  "main": "desktop/main.js",
  "scripts": {
    "desktop": "electron .",
    "check": "node --check desktop/main.js && node --check desktop/preload.js && node --check desktop/store.js && node --check desktop/account-router.js && node --check desktop/claude-executor.js && node --check desktop/renderer.js && node --check background.js && node --check content.js && node --check popup.js && node --check dashboard.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable"
  },
  "keywords": [
    "claude",
    "desktop",
    "electron",
    "account-switcher",
    "multi-account",
    "hub"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.viper373.claudehub",
    "productName": "ClaudeHub",
    "directories": {
      "output": "release"
    },
    "icon": "icons/icon256.png",
    "files": [
      "desktop/**/*",
      "icons/**/*",
      "package.json",
      "LICENSE",
      "!claude_accounts*.json",
      "!**/*.local.json",
      "!**/*.tmp",
      "!**/*.bak"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "Flames1217",
        "repo": "ClaudeHub"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClaudeHub"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
